{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newnov-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "84eab764-95ad-4ae7-91e5-0ceff73ce364","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fc9eaff991cc40bcb46c7108bcadbbe1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
